# ── Server basics ────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins ("*" allows all — avoid in prod)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# ── MongoDB (optional — server runs in email-only mode without it) ─
USE_MONGODB=true
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/indiatourguide

# ── Email notifications (Resend) ─────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=India Tours Guide <onboarding@resend.dev>
ADMIN_EMAIL=owner@example.com

# ── WhatsApp notifications (Meta Cloud API — optional, skipped when unset) ─
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_TO=919999999999

# ── Google reviews proxy (optional) ──────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxx
# Used to resolve the place id when GOOGLE_PLACE_ID is unset
GOOGLE_PLACE_QUERY=India Tours Guide Delhi

# ── Admin API ─────────────────────────────────────────────────────
# Required for /api/enquiries and admin tour/review endpoints.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# ── Encrypted-secret alternative (tools/encrypt-secret.js) ───────
# Instead of the plain keys above you may provide AES-256-GCM payloads
# (enc:v1:...) plus the master key used to create them:
# ENC_MASTER_KEY=
# RESEND_API_KEY_ENC=
# GOOGLE_PLACES_API_KEY_ENC=
